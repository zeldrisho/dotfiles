tap "zeldrisho/tap", "https://github.com/zeldrisho/homebrew-tap.git", trusted: true

# Formulae not provided by Fedora WSL's DNF package list.
brew "actionlint"
brew "gomi"
brew "herdr"
brew "pi-coding-agent"
brew "syncthing", restart_service: :changed
brew "vite-plus"
brew "yazi"

if OS.mac?
  brew "chezmoi"
  brew "fd"
  brew "fish"
  brew "gh"
  brew "git"
  brew "jq"
  brew "micro"
  brew "ripgrep"
  brew "tailscale"
  brew "uv"
  brew "zoxide"
  brew "zeldrisho/tap/smapi", trusted: true

  cask "ente-auth"
  cask "firefox"
  cask "font-jetbrains-mono-nerd-font"
  cask "google-drive"
  cask "maccy"
  cask "obsidian"
  cask "pot"
  cask "protonvpn"
  cask "steam"
  cask "sublime-text"
  cask "teamviewer"
end

# Optional packages: HOMEBREW_BUNDLE_OPTIONAL=1 brew bundle
if ENV["HOMEBREW_BUNDLE_OPTIONAL"] == "1"
  brew "morphe"
  brew "openjdk@21"
  brew "zeldrisho/tap/smali", trusted: true
end
