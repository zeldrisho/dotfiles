# Initialize Homebrew.
{{ if eq .chezmoi.os "darwin" -}}
eval (/opt/homebrew/bin/brew shellenv fish)
{{ else -}}
eval (/home/linuxbrew/.linuxbrew/bin/brew shellenv fish)
{{ end }}
set -g fish_greeting
fish_config theme choose catppuccin-mocha
set -gx EDITOR micro
set -gx MICRO_TRUECOLOR 1

if type -q zoxide
    zoxide init fish | source
end

function y
    set tmp (mktemp -t "yazi-cwd.XXXXXX")
    command yazi $argv --cwd-file="$tmp"
    if read -z cwd < "$tmp"; and test "$cwd" != "$PWD"; and test -d "$cwd"
        builtin cd -- "$cwd"
    end
    command rm -f -- "$tmp"
end

{{ if and (eq .chezmoi.os "linux") (contains "microsoft" (.chezmoi.kernel.osrelease | lower)) }}
for completion_dir in "$HOMEBREW_PREFIX/share/fish/completions" "$HOMEBREW_PREFIX/share/fish/vendor_completions.d"
    if test -d "$completion_dir"
        set -p fish_complete_path "$completion_dir"
    end
end
{{ end }}
