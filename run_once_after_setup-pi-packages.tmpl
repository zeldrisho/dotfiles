#!/bin/sh
set -eu

command -v herdr >/dev/null 2>&1
command -v vp >/dev/null 2>&1
command -v git >/dev/null 2>&1

mkdir -p "$HOME/.pi/agent/extensions"
herdr integration install pi

if [ ! -d "$HOME/Projects/pi-packages/.git" ]; then
  git clone https://github.com/zeldrisho/pi-packages "$HOME/Projects/pi-packages"
fi

cd "$HOME/Projects/pi-packages"
vp install
